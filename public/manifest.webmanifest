{
  "name": "DB Spread Bot",
  "short_name": "DB Spread Bot",
  "description": "Ask your Supabase databases in plain English — browse tables, follow up and fix data safely, no SQL needed.",
  "id": "/",
  "start_url": "/query",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#6366f1",
  "icons": [
    { "src": "/brand/dbbot-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/dbbot-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/dbbot-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Ask", "url": "/query", "icons": [{ "src": "/brand/dbbot-icon-192.png", "sizes": "192x192" }] },
    { "name": "Tables", "url": "/tables", "icons": [{ "src": "/brand/dbbot-icon-192.png", "sizes": "192x192" }] }
  ]
}
